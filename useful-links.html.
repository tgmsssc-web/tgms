<title>Useful Links | TG Model School Lingapur</title>
<style>
:root {
  --navy: #102a56;
  --gold: #e4b94f;
  --light: #f4f7fc;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  color: #26354a;
  background: var(--light);
  line-height: 1.6;
}
header {
  background: var(--navy);
  color: white;
  text-align: center;
  padding: 25px 12px;
  border-bottom: 5px solid var(--gold);
}
header h1 { margin: 0; font-size: 26px; }
header p { margin: 6px 0 0; color: #ffe29a; }
main { max-width: 900px; margin: 25px auto; padding: 0 14px; }
.intro { text-align: center; margin-bottom: 24px; }
.intro h2 { color: var(--navy); margin-bottom: 4px; }
.intro p { color: #66758b; margin-top: 0; }
.section-title {
  color: var(--navy);
  border-left: 4px solid var(--gold);
  padding-left: 10px;
  margin: 28px 0 12px;
  font-size: 20px;
}
.featured, .link-card {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 16px;
  border-radius: 11px;
  text-decoration: none;
  transition: transform .2s;
}
.featured:hover, .link-card:hover { transform: translateY(-2px); }
.featured {
  background: var(--navy);
  color: white;
  border: 2px solid var(--gold);
  margin-bottom: 25px;
}
.featured h3 { color: #ffe29a; margin: 3px 0; }
.featured p { margin: 0; overflow-wrap: anywhere; }
.priority {
  display: inline-block;
  background: var(--gold);
  color: var(--navy);
  border-radius: 15px;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: bold;
}
.icon {
  flex-shrink: 0;
  display: grid;
  place-items: center;
  width: 45px;
  height: 45px;
  border-radius: 9px;
  background: #eaf0fa;
  font-size: 23px;
}
.featured .icon { background: #ffffff20; }
.links { display: grid; gap: 11px; }
.link-card {
  background: white;
  border: 1px solid #dce4ef;
  box-shadow: 0 2px 6px #102a5608;
  min-width: 0;
}
.link-info { flex: 1; min-width: 0; }
.link-info h3 { color: var(--navy); font-size: 16px; margin: 0 0 3px; }
.link-info p { color: #66758b; font-size: 13px; margin: 0; }
.url { color: #315d9c; font-size: 12px; overflow-wrap: anywhere; }
.open {
  flex-shrink: 0;
  color: white;
  background: var(--navy);
  border-radius: 6px;
  padding: 7px 10px;
  font-size: 12px;
  font-weight: bold;
}
.last { border: 2px solid var(--gold); margin-top: 6px; }
nav {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
  margin: 30px 0;
}
nav a {
  text-decoration: none;
  border: 1px solid var(--navy);
  color: var(--navy);
  padding: 9px 22px;
  border-radius: 7px;
  font-weight: bold;
}
nav .home { background: var(--navy); color: white; }
footer {
  background: var(--navy);
  color: white;
  text-align: center;
  padding: 20px 12px;
  border-top: 4px solid var(--gold);
  font-size: 13px;
}
footer p { margin: 4px; }
footer a { color: #ffe29a; }
@media(max-width: 480px) {
  header h1 { font-size: 21px; }
  .link-card { gap: 8px; padding: 12px 9px; }
  .icon { width: 36px; height: 36px; font-size: 19px; }
  .link-info h3 { font-size: 14px; }
  .link-info p { font-size: 12px; }
  .url { font-size: 11px; }
  .open { padding: 7px; font-size: 11px; }
}
</style>
</head>
